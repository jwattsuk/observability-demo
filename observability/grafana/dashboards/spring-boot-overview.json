{
    "id": null,
    "title": "Spring Boot Application Overview",
    "tags": [
        "spring-boot",
        "observability"
    ],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 0,
    "panels": [
        {
            "id": 1,
            "title": "HTTP Requests Rate",
            "type": "stat",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_server_requests_seconds_count{job=~\"trade-service|enrichment-service\"}[5m])) by (job)",
                    "legendFormat": "{{job}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "title": "Error Rate",
            "type": "stat",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_server_requests_seconds_count{job=~\"trade-service|enrichment-service\",status=~\"5..\"}[5m])) by (job)",
                    "legendFormat": "{{job}} errors",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.1
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            }
        },
        {
            "id": 3,
            "title": "Response Time (95th percentile)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"trade-service|enrichment-service\"}[5m])) by (job, le))",
                    "legendFormat": "{{job}} - 95th percentile",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\"trade-service|enrichment-service\"}[5m])) by (job, le))",
                    "legendFormat": "{{job}} - 50th percentile",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 8
            }
        },
        {
            "id": 4,
            "title": "JVM Memory Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "jvm_memory_used_bytes{job=~\"trade-service|enrichment-service\",area=\"heap\"} / jvm_memory_max_bytes{job=~\"trade-service|enrichment-service\",area=\"heap\"} * 100",
                    "legendFormat": "{{job}} - Heap Usage %",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            }
        },
        {
            "id": 5,
            "title": "JVM Threads",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "jvm_threads_live_threads{job=~\"trade-service|enrichment-service\"}",
                    "legendFormat": "{{job}} - Live Threads",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 16
            }
        },
        {
            "id": 6,
            "title": "Database Connection Pool",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "hikaricp_connections_active{job=\"trade-service\"}",
                    "legendFormat": "Active Connections",
                    "refId": "A"
                },
                {
                    "expr": "hikaricp_connections_idle{job=\"trade-service\"}",
                    "legendFormat": "Idle Connections",
                    "refId": "B"
                },
                {
                    "expr": "hikaricp_connections_max{job=\"trade-service\"}",
                    "legendFormat": "Max Connections",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 24
            }
        }
    ],
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1
}