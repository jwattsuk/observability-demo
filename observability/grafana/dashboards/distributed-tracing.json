{
    "id": null,
    "title": "Distributed Tracing Overview",
    "tags": [
        "tracing",
        "observability"
    ],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 0,
    "panels": [
        {
            "id": 1,
            "title": "Service Map",
            "type": "nodeGraph",
            "datasource": "Tempo",
            "targets": [
                {
                    "queryType": "nativeSearch",
                    "serviceName": "",
                    "spanName": "",
                    "search": "",
                    "refId": "A"
                }
            ],
            "gridPos": {
                "h": 12,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "title": "Request Rate by Service",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (service_name) (rate(tempo_spanmetrics_calls_total{}[5m]))",
                    "legendFormat": "{{service_name}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            }
        },
        {
            "id": 3,
            "title": "Request Duration by Service",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(tempo_spanmetrics_latency_bucket{}[5m])))",
                    "legendFormat": "{{service_name}} - 95th percentile",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.50, sum by (service_name, le) (rate(tempo_spanmetrics_latency_bucket{}[5m])))",
                    "legendFormat": "{{service_name}} - 50th percentile",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            }
        },
        {
            "id": 4,
            "title": "Error Rate by Service",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (service_name) (rate(tempo_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service_name) (rate(tempo_spanmetrics_calls_total{}[5m]))",
                    "legendFormat": "{{service_name}} error rate",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1
                }
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 20
            }
        }
    ],
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1
}