{
    "id": null,
    "title": "Distributed Tracing Overview",
    "tags": [
        "tracing",
        "observability"
    ],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 0,
    "panels": [
        {
            "id": 1,
            "title": "Service Map",
            "type": "nodeGraph",
            "datasource": "Tempo",
            "targets": [
                {
                    "queryType": "serviceMap",
                    "refId": "A"
                }
            ],
            "options": {
                "edges": {
                    "mainStatUnit": "ms"
                },
                "nodes": {
                    "mainStatUnit": "ops"
                }
            },
            "gridPos": {
                "h": 12,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 2,
            "title": "Request Rate by Service",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"trade-service|enrichment-service\"}[5m]))",
                    "legendFormat": "{{application}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            }
        },
        {
            "id": 3,
            "title": "Request Duration by Service",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"trade-service|enrichment-service\"}[5m])))",
                    "legendFormat": "{{application}} - p95",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.50, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"trade-service|enrichment-service\"}[5m])))",
                    "legendFormat": "{{application}} - p50",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            }
        },
        {
            "id": 4,
            "title": "Error Rate by Service",
            "type": "timeseries",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"trade-service|enrichment-service\",status=~\"5..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"trade-service|enrichment-service\"}[5m]))",
                    "legendFormat": "{{application}} - 5xx errors",
                    "refId": "A"
                },
                {
                    "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"trade-service|enrichment-service\",status=~\"4..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"trade-service|enrichment-service\"}[5m]))",
                    "legendFormat": "{{application}} - 4xx errors",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1,
                    "color": {
                        "mode": "palette-classic"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    }
                }
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 20
            }
        }
    ],
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1
}